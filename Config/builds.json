  "builds": [
    { "name": "VIKINGYFY-IPQ53XX-HP", "source": "VIKINGYFY", "profile": "homeproxy" },
    { "name": "VIKINGYFY-IPQ53XX-NIKKI", "source": "VIKINGYFY", "profile": "nikki" },
    { "name": "LEDE-IPQ53XX-HP", "source": "LEDE", "profile": "homeproxy" },
    { "name": "LEDE-IPQ53XX-NIKKI", "source": "LEDE", "profile": "nikki" },
    { "name": "VIKINGYFY-IPQ53XX-DPD", "source": "VIKINGYFY", "profile": "dpd" },
