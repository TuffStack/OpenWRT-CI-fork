    "nikki": {
      "packages": ["nikki", "luci-app-nikki", "mihomo-alpha"],
      "feeds": ["nikki"]
    },
    "helloworld": {
      "packages": ["luci-app-ssr-plus"],
      "feeds": ["helloworld"]
    },
    "dpd": {
      "packages": ["luci-app-dpd", "dpd-fastpath", "dpd-napi", "dpd-acl", "dpd-qos", "dpd-mwan", "honk"],
      "feeds": ["dpd-fw", "honk", "v2ray-geodata"]
