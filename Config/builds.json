    "v2ray-geodata": {
      "name": "v2ray-geodata",
      "repo": "kenzok8/wall",
      "branch": "main",
      "special": "pkg",
      "prune": ["v2ray-geoip", "v2ray-geosite"]
    }
  },
  "commonFeeds": ["vantage", "lucky", "partexp", "viking"],
  "profiles": {
