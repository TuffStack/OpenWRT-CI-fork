{
  "sources": {
    "VIKINGYFY": {
      "repo": "VIKINGYFY/immortalwrt",
      "branch": "owrt",
      "packages": ["luci-app-firewall", "fullconenat-sonic", "luci-app-fullconenat-sonic"]
    },
    "LEDE": {
      "repo": "coolsnowwolf/lede",
      "branch": "master",
      "packages": ["kmod-nft-fullcone"]
    }
  },
  "feeds": {
    "vantage": { "name": "vantage", "repo": "anothaDev/luci-theme-vantage", "branch": "main" },
    "lucky": { "name": "lucky", "repo": "gdy666/luci-app-lucky", "branch": "main" },
    "partexp": { "name": "partexp", "repo": "sirpdboy/luci-app-partexp", "branch": "main" },
    "nikki": {
      "name": "nikki",
      "repo": "nikkinikki-org/OpenWrt-nikki",
      "branch": "main",
      "mode": "official-packages",
      "copy": ["nikki", "luci-app-nikki", "mihomo-alpha"],
      "prune": ["nikki", "mihomo"]
    },
    "viking": {
      "name": "viking",
      "repo": "VIKINGYFY/packages",
      "branch": "main",
      "prune": ["axonhub", "gecoosac", "miniupnpd", "sing-box", "luci-app-homeproxy", "luci-app-timewol", "luci-app-upnp", "luci-app-wolplus", "luci-app-wolultra"]
    }
  },
  "commonFeeds": ["vantage", "lucky", "partexp", "viking"],
  "profiles": {
    "homeproxy": {
      "packages": ["luci-app-homeproxy"],
      "feeds": []
    },
    "nikki": {
      "packages": ["nikki", "luci-app-nikki", "mihomo-alpha"],
      "feeds": ["nikki"]
    }
  },
  "builds": [
    { "name": "VIKINGYFY-IPQ53XX-HP", "source": "VIKINGYFY", "profile": "homeproxy" },
    { "name": "VIKINGYFY-IPQ53XX-NIKKI", "source": "VIKINGYFY", "profile": "nikki" },
    { "name": "LEDE-IPQ53XX-HP", "source": "LEDE", "profile": "homeproxy" },
    { "name": "LEDE-IPQ53XX-NIKKI", "source": "LEDE", "profile": "nikki" }
  ]
}
